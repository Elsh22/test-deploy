{
  "name": "dmc-gallery-api",
  "version": "0.1.0",
  "private": true,
  "description": "Local NestJS backend for the DMC event gallery",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "start": "nest start",
