# Local development only. Replace placeholders; never commit the real .env.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/dmc_gallery?schema=public
# Generate at least 32 random bytes; minimum length validation is not an entropy check.
JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
PORT=4000
AWS_REGION=us-east-2
# Local profile only; production should use an attached workload role/default chain.
AWS_PROFILE=dmc-gallery-dev
